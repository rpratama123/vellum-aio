diff --git a/assistant/src/ipc/routes/chatgpt-plan-ipc-routes.ts b/assistant/src/ipc/routes/chatgpt-plan-ipc-routes.ts
new file mode 100644
index 0000000..cf8cd6a
--- /dev/null
+++ b/assistant/src/ipc/routes/chatgpt-plan-ipc-routes.ts
@@ -0,0 +1,86 @@
+import {
+  BadRequestError,
+  ForbiddenError,
+  ServiceUnavailableError,
+} from "../../runtime/routes/errors.js";
+import type { RouteHandlerArgs } from "../../runtime/routes/types.js";
+
+function requireLocal({ headers }: RouteHandlerArgs) {
+  if (
+    headers?.["x-vellum-principal-type"] !== "local" ||
+    headers["x-vellum-proxy-server"]
+  ) {
+    throw new ForbiddenError("Run this command from the Vellum AIO console.");
+  }
+}
+
+export const CHATGPT_PLAN_IPC_METHODS = {
+  async aio_chatgpt_plan_begin(args: RouteHandlerArgs) {
+    requireLocal(args);
+    const port = args.body?.port;
+    if (
+      typeof port !== "number" ||
+      !Number.isInteger(port) ||
+      port < 1024 ||
+      port > 65535
+    ) {
+      throw new BadRequestError("Invalid ChatGPT callback port.");
+    }
+    const { beginChatgptPlanSignIn } = await import(
+      "../../providers/inference/chatgpt-plan.js"
+    );
+    return beginChatgptPlanSignIn(port, args.body?.newAccount === true);
+  },
+  async aio_chatgpt_plan_finish(args: RouteHandlerArgs) {
+    requireLocal(args);
+    const callback = args.body?.callback;
+    if (
+      typeof callback !== "string" ||
+      callback.length > 16_384 ||
+      !URL.canParse(callback)
+    ) {
+      throw new BadRequestError("Invalid ChatGPT callback URL.");
+    }
+    const { finishChatgptPlanSignIn } = await import(
+      "../../providers/inference/chatgpt-plan.js"
+    );
+    return finishChatgptPlanSignIn(callback);
+  },
+  async aio_chatgpt_plan_refresh(args: RouteHandlerArgs) {
+    requireLocal(args);
+    const { refreshChatgptPlanModels } = await import(
+      "../../providers/inference/chatgpt-plan.js"
+    );
+    const result = await refreshChatgptPlanModels();
+    if (!result) {
+      throw new BadRequestError(
+        "Sign in to ChatGPT before refreshing the model list.",
+      );
+    }
+    return result;
+  },
+  async aio_chatgpt_plan_disconnect(args: RouteHandlerArgs) {
+    requireLocal(args);
+    const { disconnectChatgptPlan } = await import(
+      "../../providers/inference/chatgpt-plan.js"
+    );
+    return disconnectChatgptPlan();
+  },
+  async aio_chatgpt_plan_renew(args: RouteHandlerArgs) {
+    requireLocal(args);
+    const credential = args.body?.credential;
+    if (typeof credential !== "string") {
+      throw new BadRequestError("Missing ChatGPT session reference.");
+    }
+    const { renewChatgptPlanSession } = await import(
+      "../../providers/inference/chatgpt-plan.js"
+    );
+    try {
+      return { renewed: await renewChatgptPlanSession(credential) };
+    } catch {
+      throw new ServiceUnavailableError(
+        "ChatGPT session refresh failed. Reconnect in the Vellum AIO console if the issue persists.",
+      );
+    }
+  },
+};
