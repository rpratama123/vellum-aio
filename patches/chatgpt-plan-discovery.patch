+import {
+  createHash,
+  createPublicKey,
+  randomBytes,
+  randomUUID,
+  verify,
+} from "node:crypto";
+import { z } from "zod";
+
+import { getDb } from "../../persistence/db-connection.js";
+import {
+  chatgptModelSlug,
+  isChatgptPlanCredential,
+} from "../openai/chatgpt-plan-identifiers.js";
+import {
+  deleteSecureKeyAsync,
+  getSecureKeyResultAsync,
+  setSecureKeyAsync,
+} from "../../security/secure-keys.js";
+import { getLogger } from "../../util/logger.js";
+import { CHATGPT_SUBSCRIPTION_CONNECTION_NAME } from "./auth.js";
+import {
+  createConnection,
+  getConnection,
+  updateConnection,
+} from "./connections.js";
+
+const log = getLogger("chatgpt-plan");
+const issuer = "https://auth.openai.com";
+const resource = "https://api.openai.com/v1";
+const hostKey = "credential/chatgpt-plan/host";
+const bootstrapClientId = "dynamic_agent_client";
+const planScopes = [
+  "offline_access",
+  "resource.invoke",
+  "chatgpt.tokens.use.direct",
+];
+const scopes = ["openid", "profile", "email", ...planScopes];
+const timeoutMs = 15_000;
+
+const grantSchema = z.object({
+  access_token: z.string().min(1),
+  refresh_token: z.string().min(1).optional(),
+  id_token: z.string().min(1).optional(),
+  expires_in: z.number().positive(),
+  scope: z.string().optional(),
+  token_type: z.string().refine((value) => value.toLowerCase() === "bearer"),
+});
+
+const registrationSchema = z.object({
+  clientId: z.string().min(1),
+  subject: z.string().min(1),
+  email: z.email().optional(),
+});
+const sessionSchema = registrationSchema.extend({
+  accessToken: z.string().min(1),
+  refreshToken: z.string().min(1),
+  expiresAt: z.number(),
+  scopes: z.array(z.string()),
+});
+type Registration = z.infer<typeof registrationSchema>;
+type Session = z.infer<typeof sessionSchema>;
+
+type PendingSignIn = {
+  state: string;
+  nonce: string;
+  verifier: string;
+  redirect: string;
+  expiresAt: number;
+  previous?: Registration;
+};
+let pending: PendingSignIn | undefined;
+let operation: Promise<unknown> = Promise.resolve();
+
+// The assistant IPC server is the only writer of direct-plan sessions.
+// Sidecar workers ask that server for access tokens, so only one process
+// exchanges each rotating refresh token.
+function serialized<T>(fn: () => Promise<T>): Promise<T> {
+  const next = operation.then(fn);
+  operation = next.catch(() => {});
+  return next;
+}
+
+async function exchange(params: Record<string, string>) {
+  const response = await fetch(`${issuer}/api/accounts/oauth/token`, {
+    method: "POST",
+    body: new URLSearchParams({ ...params, resource }),
+    redirect: "error",
+    signal: AbortSignal.timeout(timeoutMs),
+  });
+  if (!response.ok) {
+    throw new Error(`ChatGPT token exchange returned HTTP ${response.status}.`);
+  }
+  const result = grantSchema.safeParse(await response.json());
+  if (!result.success) {
+    throw new Error("ChatGPT token exchange returned an incomplete grant.");
+  }
+  return result.data;
+}
+
+async function readSecureValue(key: string) {
+  const result = await getSecureKeyResultAsync(key);
+  if (result.unreachable) {
+    throw new Error("The credential store is temporarily unavailable.");
+  }
+  return result.value;
+}
+
+async function readRecord<T>(
+  key: string,
+  schema: z.ZodType<T>,
+): Promise<T | undefined> {
+  const raw = await readSecureValue(key);
+  return raw ? schema.parse(JSON.parse(raw)) : undefined;
+}
+
+async function saveSession(key: string, session: Session): Promise<void> {
+  if (!(await setSecureKeyAsync(key, JSON.stringify(session)))) {
+    throw new Error(
+      "Could not save the ChatGPT session to the credential store.",
+    );
+  }
+}
+
+function currentConnection() {
+  const db = getDb();
+  return getConnection(db, CHATGPT_SUBSCRIPTION_CONNECTION_NAME);
+}
+
+export function beginChatgptPlanSignIn(port: number, newAccount: boolean) {
+  return serialized(async () => {
+    let host = await readSecureValue(hostKey);
+    if (!host) {
+      host = `urn:uuid:${randomUUID()}`;
+      if (!(await setSecureKeyAsync(hostKey, host))) {
+        throw new Error(
+          "Could not save the ChatGPT host ID to the credential store.",
+        );
+      }
+    }
