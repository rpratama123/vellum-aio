+import { afterAll, expect, mock, test } from "bun:test";
+import { createHash, generateKeyPairSync, sign } from "node:crypto";
+
+import type { ProviderConnection } from "./auth.js";
+
+const secrets = new Map<string, string>();
+let current: ProviderConnection | null = null;
+
+mock.module("../../persistence/db-connection.js", () => ({
+  getDb: () => ({}),
+}));
+mock.module("../../security/secure-keys.js", () => ({
+  getSecureKeyResultAsync: async (key: string) => ({ value: secrets.get(key) }),
+  setSecureKeyAsync: async (key: string, value: string) => {
+    secrets.set(key, value);
+    return true;
+  },
+  deleteSecureKeyAsync: async (key: string) =>
+    secrets.delete(key) ? "deleted" : "not-found",
+}));
+mock.module("./connections.js", () => ({
+  getConnection: () => current,
+  createConnection: (_db: unknown, input: ProviderConnection) => {
+    current = input;
+    return { ok: true };
+  },
+  updateConnection: (
+    _db: unknown,
+    _name: string,
+    input: Partial<ProviderConnection>,
+  ) => {
+    current = { ...current!, ...input };
+    return { ok: true };
+  },
+}));
+
+const {
+  beginChatgptPlanSignIn,
+  disconnectChatgptPlan,
+  finishChatgptPlanSignIn,
+  getChatgptPlanAccessToken,
