+    const url = new URL("/api/accounts/authorize", issuer);
+    url.search = new URLSearchParams({
+      client_id: previous?.clientId ?? bootstrapClientId,
+      ...(!previous ? { agent_name_hint: "Vellum AIO" } : {}),
+      ext_agent_host_id: host,
+      response_type: "code",
+      redirect_uri: redirect,
+      resource,
+      scope: scopes.join(" "),
+      state,
+      nonce,
+      code_challenge_method: "S256",
+      code_challenge: createHash("sha256").update(verifier).digest("base64url"),
+    }).toString();
+    return { url: url.href };
+  });
+}
+
+interface ModelEntry {
+  id: string;
+  displayName: string;
+}
+
+const modelResponseSchema = z.object({
+  models: z.array(
+    z.object({
+      slug: z.string(),
+      display_name: z.string().nullish(),
+      visibility: z.string(),
+    }),
+  ),
+});
+
+async function fetchModels(accessToken: string): Promise<ModelEntry[]> {
+  const response = await fetch(`${resource}/models`, {
+    headers: { Authorization: `Bearer ${accessToken}` },
+    redirect: "error",
+    signal: AbortSignal.timeout(timeoutMs),
+  });
+  if (!response.ok) {
+    throw new Error(
+      `ChatGPT model discovery returned HTTP ${response.status}.`,
+    );
+  }
+  const result = modelResponseSchema.safeParse(await response.json());
+  if (!result.success) {
+    throw new Error("ChatGPT model discovery returned an invalid catalog.");
+  }
+  const models = new Map<string, ModelEntry>();
+  for (const item of result.data.models) {
+    if (
+      item.visibility === "list" &&
+      chatgptModelSlug.test(item.slug) &&
+      !models.has(item.slug)
+    ) {
+      models.set(item.slug, {
+        id: item.slug,
+        displayName: item.display_name?.trim().slice(0, 200) || item.slug,
+      });
+    }
+  }
+  return [...models.values()];
+}
+
+function scopesForGrant(
+  scope: string | undefined,
+  previous: string[] = [],
+): string[] {
+  const granted = scope === undefined ? previous : scope.trim().split(/\s+/);
+  if (!planScopes.every((value) => granted.includes(value))) {
+    throw new Error("ChatGPT plan permission was not granted.");
+  }
+  return granted;
+}
+
+const idTokenHeader = z.object({
+  alg: z.literal("RS256"),
+  kid: z.string().min(1),
+});
+const idTokenPayload = z.object({
+  iss: z.literal(issuer),
+  aud: z.union([z.string(), z.array(z.string())]),
+  azp: z.string().optional(),
+  exp: z.number().int(),
+  nbf: z.number().int().optional(),
+  nonce: z.string(),
+  sub: z.string().min(1),
+  email: z.email().optional(),
+});
+const publicKeys = z.object({
+  keys: z.array(
+    z.object({
+      kid: z.string(),
+      kty: z.string(),
+      e: z.string().optional(),
+      n: z.string().optional(),
+      use: z.string().optional(),
+      alg: z.string().optional(),
+    }),
+  ),
+});
+
+async function verifyIdentity(token: string, clientId: string, nonce: string) {
+  try {
+    const parts = token.split(".");
+    if (
+      parts.length !== 3 ||
+      parts.some((part) => !/^[A-Za-z0-9_-]+$/.test(part))
+    ) {
+      throw new Error();
+    }
+    const [header, payload, signature] = parts;
+    const claims = idTokenPayload.parse(
+      JSON.parse(Buffer.from(payload, "base64url").toString()),
+    );
+    const { kid } = idTokenHeader.parse(
+      JSON.parse(Buffer.from(header, "base64url").toString()),
+    );
+    const response = await fetch(`${issuer}/.well-known/jwks.json`, {
+      redirect: "error",
+      signal: AbortSignal.timeout(timeoutMs),
+    });
+    if (!response.ok) {
+      throw new Error();
+    }
+    const { keys } = publicKeys.parse(await response.json());
+    const key = keys.find(
+      (entry) =>
+        entry.kid === kid &&
+        entry.kty === "RSA" &&
+        (entry.use === undefined || entry.use === "sig") &&
+        (entry.alg === undefined || entry.alg === "RS256"),
+    );
+    const audience = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
+    const now = Math.floor(Date.now() / 1000);
+    if (
+      !key?.n ||
+      !key.e ||
+      !verify(
+        "RSA-SHA256",
+        Buffer.from(`${header}.${payload}`),
+        createPublicKey({ key, format: "jwk" }),
+        Buffer.from(signature, "base64url"),
+      ) ||
+      !audience.includes(clientId) ||
+      ((audience.length > 1 || claims.azp !== undefined) &&
+        claims.azp !== clientId) ||
+      claims.nonce !== nonce ||
+      claims.exp <= now ||
+      (claims.nbf !== undefined && claims.nbf > now)
+    ) {
+      throw new Error();
+    }
+    return { subject: claims.sub, email: claims.email };
+  } catch {
+    throw new Error("Could not verify the ChatGPT ID token.");
+  }
+}
+
+export function finishChatgptPlanSignIn(callbackUrl: string) {
+  return serialized(async () => {
+    const attempt = pending;
+    const callback = new URL(callbackUrl);
+    const query = callback.searchParams;
+    if (
+      !attempt ||
+      Date.now() >= attempt.expiresAt ||
+      callback.origin + callback.pathname !== attempt.redirect ||
+      query.get("state") !== attempt.state
+    ) {
+      throw new Error(
+        "The ChatGPT sign-in callback did not match the pending attempt.",
+      );
+    }
+    pending = undefined;
+    if (query.has("error")) {
+      throw new Error("ChatGPT sign-in was declined.");
+    }
+    const clientId = query.get("client_id") ?? attempt.previous?.clientId;
+    const code = query.get("code");
+    if (
+      !clientId ||
+      clientId === bootstrapClientId ||
+      !code ||
+      (attempt.previous && clientId !== attempt.previous.clientId)
+    ) {
+      throw new Error("ChatGPT sign-in returned an invalid code or client ID.");
+    }
+    const grant = await exchange({
+      client_id: clientId,
+      grant_type: "authorization_code",
+      code,
+      code_verifier: attempt.verifier,
+      redirect_uri: attempt.redirect,
+    });
+    if (!grant.id_token || !grant.refresh_token) {
+      throw new Error(
+        "ChatGPT did not return an ID token and renewable session.",
+      );
+    }
+    const { subject, email } = await verifyIdentity(
+      grant.id_token,
+      clientId,
+      attempt.nonce,
+    );
+    if (attempt.previous && attempt.previous.subject !== subject) {
+      throw new Error(
+        "The ChatGPT identity did not match the sign-in attempt.",
+      );
+    }
+    const session: Session = {
+      clientId,
+      subject,
+      accessToken: grant.access_token,
+      refreshToken: grant.refresh_token,
+      expiresAt: Date.now() + grant.expires_in * 1000,
+      scopes: scopesForGrant(grant.scope),
+    };
+    const models = await fetchModels(session.accessToken);
+    if (models.length === 0) {
+      throw new Error(
+        "ChatGPT returned no selectable models for this account.",
+      );
+    }
+    const accountHash = createHash("sha256")
+      .update(JSON.stringify([clientId, subject]))
+      .digest("hex");
+    const credential = `credential/chatgpt-plan/${accountHash}`;
+    if (
+      !(await setSecureKeyAsync(
+        `${credential}/registration`,
+        JSON.stringify({ clientId, subject, email }),
+      ))
+    ) {
+      throw new Error(
+        "Could not save the ChatGPT registration to the credential store.",
+      );
+    }
+    await saveSession(credential, session);
+
+    const db = getDb();
+    const input = {
+      provider: "chatgpt",
+      auth: { type: "oauth_subscription" as const, credential },
+      models,
+    };
+    const name = CHATGPT_SUBSCRIPTION_CONNECTION_NAME;
+    const result = getConnection(db, name)
+      ? updateConnection(db, name, input)
+      : createConnection(db, { ...input, name });
+    if (!result.ok) {
+      throw new Error("Could not update the ChatGPT subscription connection.");
+    }
+    return { models: models.length };
+  });
+}
+
+async function accessTokenFor(credential: string): Promise<string | undefined> {
+  const session = await readRecord(credential, sessionSchema);
+  if (!session) {
+    return undefined;
+  }
+  const remaining = session.expiresAt - Date.now();
+  if (remaining > 120_000) {
+    return session.accessToken;
+  }
+  const grant = await exchange({
+    client_id: session.clientId,
+    grant_type: "refresh_token",
+    refresh_token: session.refreshToken,
+  });
+  const renewed: Session = {
+    ...session,
+    accessToken: grant.access_token,
+    refreshToken: grant.refresh_token ?? session.refreshToken,
+    expiresAt: Date.now() + grant.expires_in * 1000,
+    scopes: scopesForGrant(grant.scope, session.scopes),
+  };
+  await saveSession(credential, renewed);
+  return renewed.accessToken;
+}
+
+export async function getChatgptPlanAccessToken(credential: string) {
+  if (!isChatgptPlanCredential(credential)) {
+    return undefined;
+  }
+  let session = await readRecord(credential, sessionSchema);
+  if (session && session.expiresAt - Date.now() <= 120_000) {
+    // Only the assistant IPC server rotates the session. Respond with a
+    // status and let each authorized caller read the new record from CES.
+    const { cliIpcCall } = await import("../../ipc/cli-client.js");
+    const result = await cliIpcCall("aio_chatgpt_plan_renew", {
+      body: { credential },
+    });
+    if (!result.ok) {
+      throw new Error(result.error ?? "Could not renew ChatGPT plan usage.");
+    }
+    session = await readRecord(credential, sessionSchema);
+  }
+  return session?.accessToken;
+}
+
+export function renewChatgptPlanSession(credential: string) {
+  return serialized(async () => {
+    const current = currentConnection()?.auth;
+    if (
+      current?.type !== "oauth_subscription" ||
+      current.credential !== credential ||
+      !isChatgptPlanCredential(credential)
+    ) {
+      return false;
+    }
+    return Boolean(await accessTokenFor(credential));
+  });
+}
+
+export function refreshChatgptPlanModels(): Promise<{ models: number } | null> {
+  return serialized(async () => {
+    const connection = currentConnection();
+    const auth = connection?.auth;
+    if (
+      auth?.type !== "oauth_subscription" ||
+      !isChatgptPlanCredential(auth.credential)
+    ) {
+      return null;
+    }
+    const accessToken = await accessTokenFor(auth.credential);
+    if (!accessToken) {
+      throw new Error(
+        "Run ChatGPT sign-in to restore the subscription session.",
+      );
+    }
+    const models = await fetchModels(accessToken);
+    const current = currentConnection();
+    if (
+      current?.auth.type !== "oauth_subscription" ||
+      current.auth.credential !== auth.credential
+    ) {
+      return null;
+    }
+    if (JSON.stringify(current.models) !== JSON.stringify(models)) {
+      const result = updateConnection(getDb(), current.name, { auth, models });
+      if (!result.ok) {
+        throw new Error(
+          "Could not refresh the ChatGPT subscription model list.",
+        );
+      }
+    }
+    return { models: models.length };
+  });
+}
+
+export function disconnectChatgptPlan(): Promise<{ revoked: boolean }> {
+  return serialized(async () => {
+    const connection = currentConnection();
+    const auth = connection?.auth;
+    if (
+      auth?.type !== "oauth_subscription" ||
+      !isChatgptPlanCredential(auth.credential)
+    ) {
+      throw new Error("No direct ChatGPT plan session is connected.");
+    }
+    const session = await readRecord(auth.credential, sessionSchema);
+    let revoked = false;
+    if (session) {
+      for (const delay of [0, 750, 1500]) {
+        if (delay) {
+          await Bun.sleep(delay);
+        }
+        try {
+          const response = await fetch(`${issuer}/api/accounts/oauth/revoke`, {
+            method: "POST",
+            body: new URLSearchParams({
+              token: session.refreshToken,
+              token_type_hint: "refresh_token",
+              client_id: session.clientId,
+            }),
+            redirect: "error",
+            signal: AbortSignal.timeout(5_000),
+          });
+          revoked = response.ok;
+          if (response.status < 500) {
+            break;
+          }
+        } catch {
+          // Transient transport failure. Retry while the token is available.
+        }
+      }
+    }
+    const result = await deleteSecureKeyAsync(auth.credential);
+    if (result === "error") {
+      throw new Error(
+        "Could not remove the ChatGPT credentials from the credential store.",
+      );
+    }
+    const current = currentConnection();
+    if (
+      current?.auth.type === "oauth_subscription" &&
+      current.auth.credential === auth.credential
+    ) {
+      updateConnection(getDb(), current.name, { auth, models: [] });
+    }
+    return { revoked };
+  });
+}
+
+let modelTimer: ReturnType<typeof setInterval> | undefined;
+
+export function startChatgptPlanCatalogRefresh() {
+  if (modelTimer) {
+    return;
+  }
+  const refresh = () => {
+    void refreshChatgptPlanModels().catch((err: unknown) => {
+      log.warn(
+        {
+          error: err instanceof Error ? err.message : "catalog refresh failed",
+        },
+        "Could not refresh ChatGPT models",
+      );
+    });
+  };
+  refresh();
+  modelTimer = setInterval(refresh, 15 * 60 * 1000);
+  modelTimer.unref();
+}
